# Telegram API Credentials
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE_NUMBER=your_phone_number_here
TELEGRAM_2FA_PASSWORD=your_2fa_password_here  # Optional: Set if you want automatic 2FA login

# Telegram Chat/Group Settings
TARGET_CHAT_ID=your_target_chat_id_here  # ID of the supergroup to fetch topics from

# Optional: Session file name (default: session_name.session)
SESSION_FILE=session_name.session
